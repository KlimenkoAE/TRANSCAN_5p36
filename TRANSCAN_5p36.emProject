<!DOCTYPE CrossStudio_Project_File>
<solution Name="TRANSCAN_5p36" target="8" version="2">
  <configuration
    Name="Debug"
    c_preprocessor_definitions="DEBUG"
    gcc_debugging_level="Level 3"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="None" />
  <configuration
    Name="Release"
    c_preprocessor_definitions="NDEBUG"
    gcc_debugging_level="Level 2"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 2 balanced"
    link_dedupe_code="Yes" />
  <configuration
    LIBRARY_HEAP_TYPE="Minimal"
    LIBRARY_IO_TYPE="SEMIHOST (host-formatted)"
    LIBRARY_LOCALES="Minimal"
    Name="Release_MinSize"
    arm_library_optimization="Small"
    c_preprocessor_definitions="NDEBUG;__OPTIMIZATION_SMALL"
    cpp_enable_exceptions="No"
    gcc_debugging_level="None"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 2 for size"
    gcc_short_enum="Minimal Container Size"
    libcxx="Yes (No Exceptions)"
    link_dedupe_code="Yes"
    link_dedupe_data="Yes"
    link_merge_strings="Yes"
    link_time_optimization="Yes"
    linker_printf_fmt_level="int"
    linker_printf_fp_enabled="No"
    linker_printf_width_precision_supported="No" />
  <project Name="TRANSCAN_5p36">
    <configuration
      LIBRARY_IO_TYPE="RTT"
      Name="Common"
      Target="LM3S5P36"
      arm_architecture="v7M"
      arm_compiler_variant="SEGGER"
      arm_core_type="Cortex-M3"
      arm_endian="Little"
      arm_linker_heap_size="2048"
      arm_linker_process_stack_size="0"
      arm_linker_stack_size="2048"
      arm_linker_variant="SEGGER"
      arm_target_device_name="LM3S5P36"
      arm_target_interface_type="SWD"
      c_user_include_directories=".;../StellarisWare/;../StellarisWare/inc/;../StellarisWare/driverlib/"
      debug_stack_pointer_start="__stack_end__"
      debug_target_connection="J-Link"
      gcc_cplusplus_language_standard="c++23"
      gcc_entry_point="Reset_Handler"
      link_linker_script_file="Setup/SEGGER_Flash.icf"
      linker_output_format="hex"
      linker_section_placements_segments="FLASH1 RX 0x00000000 0x00010000;RAM1 RWX 0x20000000 0x00006000;"
      macros="Target=LM3S5P36"
      project_directory=""
      project_type="Executable" />
    <configuration
      Name="Debug"
      arm_compiler_variant="SEGGER"
      arm_target_interface_type="SWD"
      c_preprocessor_definitions="gcc"
      c_user_include_directories="."
      gcc_cplusplus_language_standard="c++23"
      speed="1000" />
    <configuration
      LIBRARY_IO_TYPE="SEMIHOST (host-formatted)"
      Name="Release_MinSize" />
    <folder Name="Include">
      <file file_name="_CAN.hpp" />
      <file file_name="_CDC.hpp" />
      <file file_name="_TIMERS.hpp" />
      <file file_name="_USB.hpp" />
      <file file_name="BackEnd.hpp" />
      <file file_name="fifo_ring.hpp" />
      <file file_name="MyTuples.hpp" />
      <file file_name="periferalInterruptsHandlers.hpp" />
      <file file_name="periferalISR.hpp" />
      <file file_name="serial_print.hpp" />
      <file file_name="USB_CLASSES.hpp" />
      <file file_name="USB_CONSTS.hpp" />
      <file file_name="USB_THIS_PROGRAM_DEFS.hpp" />
      <file file_name="VENDOR_CONSTANT_WRAP.hpp" />
      <file file_name="VendorFunctionsWrap.hpp" />
      <file file_name="wrappers_declarations.hpp" />
    </folder>
    <folder Name="Setup" />
    <folder Name="Source">
      <file file_name="_TIMERS.cpp" />
      <file file_name="_UCB.cpp" />
      <file file_name="main.cpp">
        <configuration
          Name="Common"
          c_user_include_directories=".;../StellarisWare;../StellarisWare/inc" />
      </file>
      <file file_name="periferalISR.cpp" />
      <file file_name="../StellarisWare/driverlib/usb.c" />
    </folder>
    <folder Name="System">
      <file file_name="$(DeviceVectorsFile:)" />
      <file file_name="System/Cortex_M_Startup.s" />
      <file file_name="../StellarisWare/driverlib/gcc-cm3/libdriver-cm3.a" />
      <file file_name="System/SEGGER_THUMB_Startup.s" />
    </folder>
  </project>
</solution>
